+            const block_q8_1 * bq8 = y + j*stride_col_y + kby + t2;
+            // qs is only 4-byte aligned (offset by half2 ds): scalar int loads, no int4
+            int yq[8];
+            {
+                const int * qsy = (const int *) bq8->qs;
+#pragma unroll
+                for (int q = 0; q < 8; ++q) {
+                    yq[q] = qsy[q];
+                }
+            }
+            const float yds = __low2float(bq8->ds);
+
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                int s0 = ggml_cuda_dp4a(v[i][0], yq[0], 0);
+                s0 = ggml_cuda_dp4a(v[i][1], yq[2], s0);
+                s0 = ggml_cuda_dp4a(v[i][2], yq[1], s0);
+                s0 = ggml_cuda_dp4a(v[i][3], yq[3], s0);
+                int s1 = ggml_cuda_dp4a(v[i][4], yq[4], 0);
+                s1 = ggml_cuda_dp4a(v[i][5], yq[6], s1);
+                s1 = ggml_cuda_dp4a(v[i][6], yq[5], s1);
+                s1 = ggml_cuda_dp4a(v[i][7], yq[7], s1);
+                tmp[j][i] += wd[i][0]*yds*(float) s0 + wd[i][1]*yds*(float) s1;
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][ncols_dst][rows_per_block][32];
+
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+    dst += row0;
+
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<32>(tmp[j][i]);
+            if (threadIdx.x == i && uint32_t(row0 + i) < nrows_x) {
+                dst[j*stride_col_dst + i] = tmp[j][i];
+            }
+        }
+    }
+}
